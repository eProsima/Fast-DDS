names:
    fastdds:
        cmake-args:
            - "-DEPROSIMA_BUILD_TESTS=ON"
            - "-DFASTDDS_PIM_API_TESTS=ON"
            - "-DPERFORMANCE_TESTS=ON"
            - "-DPROFILING_TESTS=OFF"
            - "-DCOMPILE_TOOLS=ON"
            - "-DSYSTEM_TESTS=ON"
        # TEMPORARY (flake hunt, revert before merge): "--repeat", "until-pass:3" removed from this list.
        # CTest allows at most one --repeat, and the flake hunt sets --repeat until-fail:100 in the workflow.
        ctest-args: [
                "--timeout", "300",
                "--label-exclude", "xfail"
        ]
    googletest-distribution:
        cmake-args:
            - "-Dgtest_force_shared_crt=ON"
            - "-DBUILD_SHARED_LIBS=ON"
            - "-DBUILD_GMOCK=ON"
